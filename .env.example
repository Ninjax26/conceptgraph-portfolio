# PostgreSQL is the durable source of truth for jobs, leases, retries, and courses.
# DATABASE_URL takes precedence over the individual POSTGRES_* values.
DATABASE_URL=
POSTGRES_USER=conceptgraph
POSTGRES_PASSWORD=conceptgraph_password
POSTGRES_DB=conceptgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=conceptgraph_password

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=conceptgraph_chunks
QDRANT_API_KEY=

# Local mode requires: pip install -r requirements-local-models.txt
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANK_PROVIDER=local
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Low-memory hosted mode:
# EMBEDDING_PROVIDER=qdrant_cloud
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# RERANK_PROVIDER=cohere
# RERANK_MODEL_NAME=rerank-v3.5
COHERE_API_KEY=
PROVIDER_TIMEOUT_SECONDS=30
GRAPH_BATCH_SIZE=4
GRAPH_MAX_BATCHES=6

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
LLM_FAILOVER_COOLDOWN_SECONDS=300
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OBJECT_STORAGE_BACKEND=s3
S3_BUCKET=conceptgraph-pdfs
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=conceptgraph
S3_SECRET_ACCESS_KEY=conceptgraph_local_only
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_SERVER_SIDE_ENCRYPTION=

ALLOWED_ORIGINS=
DEMO_ACCESS_TOKEN=
AUTH_COOKIE_NAME=conceptgraph_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SECONDS=43200
REQUIRE_UPLOAD_AUTH=false
PUBLIC_SAMPLE_COURSE_ID=
DEMO_UPLOAD_RETENTION_DAYS=3
DEMO_CLEANUP_INTERVAL_SECONDS=21600
STRICT_STARTUP_VALIDATION=false

RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10

PROCESSING_CONCURRENCY=1
PROCESSING_QUEUE_CAPACITY=8
PROCESSING_LEASE_SECONDS=180
PROCESSING_HEARTBEAT_SECONDS=30
PROCESSING_DISPATCH_INTERVAL_SECONDS=2
MAX_PDF_SIZE_MB=10
MAX_PDFS_PER_INSTALLATION=50

EVIDENCE_MIN_SCORE=0.35
EVIDENCE_MEDIUM_SCORE=0.5
EVIDENCE_HIGH_SCORE=0.7
