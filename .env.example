# PostgreSQL is the durable source of truth for jobs, leases, retries, and courses.
# DATABASE_URL takes precedence over the individual POSTGRES_* values.
DATABASE_URL=
POSTGRES_USER=conceptgraph
POSTGRES_PASSWORD=conceptgraph_password
POSTGRES_DB=conceptgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=conceptgraph_password

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=conceptgraph_chunks
QDRANT_API_KEY=

# Local mode requires: pip install -r requirements-local-models.txt
EMBEDDING_PROVIDER=local
LOCAL_MODEL_DEVICE=auto
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANK_PROVIDER=local
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Low-memory hosted mode:
# EMBEDDING_PROVIDER=qdrant_cloud
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# RERANK_PROVIDER=cohere
# RERANK_MODEL_NAME=rerank-v3.5
COHERE_API_KEY=
# Bound reranking work. Identifier lookup adds a scoped payload query, not another embedding.
RETRIEVAL_CANDIDATE_LIMIT=10
RETRIEVAL_IDENTIFIER_LOOKUP=true
RETRIEVAL_IDENTIFIER_LIMIT=10
RETRIEVAL_VERIFY_IDENTIFIERS=true
PROVIDER_TIMEOUT_SECONDS=30
GRAPH_BATCH_SIZE=4
GRAPH_MAX_BATCHES=6
GRAPH_GLOBAL_LINKING_ENABLED=true
# At most one extra structured-output repair after provider failover per batch.
# Set false to disable this extra call; quota/timeouts never trigger repair.
GRAPH_JSON_REPAIR_ENABLED=true

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
LLM_FAILOVER_COOLDOWN_SECONDS=300
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OBJECT_STORAGE_BACKEND=s3
S3_BUCKET=conceptgraph-pdfs
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=conceptgraph
S3_SECRET_ACCESS_KEY=conceptgraph_local_only
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
S3_SERVER_SIDE_ENCRYPTION=

ALLOWED_ORIGINS=
DEMO_ACCESS_TOKEN=
AUTH_COOKIE_NAME=conceptgraph_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SECONDS=43200
REQUIRE_UPLOAD_AUTH=false
PUBLIC_SAMPLE_COURSE_ID=
DEMO_UPLOAD_RETENTION_DAYS=3
DEMO_CLEANUP_INTERVAL_SECONDS=21600
STRICT_STARTUP_VALIDATION=false

RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10

PROCESSING_CONCURRENCY=1
# combined keeps the original single-process demo. Split deployments use api and worker.
PROCESSING_ROLE=combined
# Mandatory on both API and worker when using split-process operation.
SHARED_PROVIDER_LIMITS_ENABLED=false
SHARED_PROVIDER_SCOPE=conceptgraph
# Application-wide per-provider request budgets, not advertised provider quotas.
PROVIDER_REQUESTS_PER_MINUTE=10
PROVIDER_REQUESTS_PER_DAY=300
PROCESSING_QUEUE_CAPACITY=8
PROCESSING_LEASE_SECONDS=180
PROCESSING_HEARTBEAT_SECONDS=30
PROCESSING_DISPATCH_INTERVAL_SECONDS=2
MAX_PDF_SIZE_MB=10
MAX_PDFS_PER_INSTALLATION=50
# Set the legacy count cap to 0 to rely on the resource budgets below.
MAX_PAGES_PER_DOCUMENT=500
MAX_PAGES_PER_INSTALLATION=10000
MAX_CHUNKS_PER_DOCUMENT=2000
MAX_CHUNKS_PER_INSTALLATION=50000
CHUNK_RESERVATION_PER_PAGE=32
MAX_STORAGE_MB=1024
MAX_PENDING_DOCUMENTS=32
GRAPH_DISPLAY_MAX_NODES=100
GRAPH_DISPLAY_MAX_EDGES=200
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MIN_NATIVE_CHARACTERS=40
OCR_MAX_PAGES_PER_DOCUMENT=50
OCR_PAGE_TIMEOUT_SECONDS=20
OCR_MIN_CONFIDENCE=55
OCR_MAX_RENDER_PIXELS=12000000
OCR_MIXED_PAGES_ENABLED=true
OCR_RETRY_ENABLED=true

EVIDENCE_MIN_SCORE=0.35
EVIDENCE_MEDIUM_SCORE=0.5
EVIDENCE_HIGH_SCORE=0.7
